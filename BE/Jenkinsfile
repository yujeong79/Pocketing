pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('BE') {
                    sh '''
                    chmod +x gradlew
                    ./gradlew clean build -x test
                    '''
                }
            }
        }

        stage('Copy Config From Container') {
            steps {
                sh '''
                docker cp backend:/resources BE/src/main/resources
                '''
            }
        }

        stage('Deploy') {
            steps {
                dir('BE') {
                    sh '''
                    docker compose version
                    docker compose -f /pocketing/docker-compose.pocketing.yml stop backend
                    docker compose -f /pocketing/docker-compose.pocketing.yml rm -f backend
                    docker compose -f /pocketing/docker-compose.pocketing.yml up -d --build backend
                    '''
                }
            }
        }
    }
}
