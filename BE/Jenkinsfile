pipeline {
    agent any

    environment {
        SWITCH_SCRIPT = '/pocketing/fe/nginx/switch_nginx.sh'
        UPSTREAM_CONF = '/pocketing/fe/nginx/upstream.conf'
    }

    stages {
        stage('Build Backend') {
            steps {
                dir('BE') {
                    sh '''
                    chmod +x gradlew
                    ./gradlew clean build -x test
                    '''
                }
            }
        }

        stage('Copy Config From Container') {
            steps {
                sh '''
                docker cp backend:/resources/application.yml BE/src/main/resources/application.yml
                docker cp backend:/resources/application-prod.yml BE/src/main/resources/application-prod.yml
                docker cp backend:/resources/firebase-service-account.json BE/src/main/resources/firebase-service-account.json
                '''
            }
        }

        stage('Determine Target Container') {
          steps {
            script {
              def currentBackend = sh(
                script: '''
                  set -e
                  CLEANED=$(mktemp)
                  # CRLF 제거 + 라인 끝 주석 제거
                  sed -e "s/\\r$//" -e "s/#.*$//" "$UPSTREAM_CONF" > "$CLEANED"

                  # backend_*만 추출
                  grep -Eo "backend-(blue|green)" "$CLEANED" | head -n 1
                ''',
                returnStdout: true
              ).trim()

              if (!currentBackend) {
                error "🚨 upstream.conf에서 활성 백엔드를 찾지 못했습니다."
              }

              env.CURRENT_BACKEND = currentBackend
              env.NEXT_BACKEND = (currentBackend == "backend-blue") ? "backend-green" : "backend-blue"

              echo "🟢 현재 활성화된 백엔드: ${env.CURRENT_BACKEND}"
              echo "🟠 새로 배포할 백엔드: ${env.NEXT_BACKEND}"
            }
          }
        }

        stage('Deploy New Backend') {
            steps {
                dir('BE') {
                    sh """
                    docker compose -f /pocketing/docker-compose.pocketing.yml stop ${NEXT_BACKEND} || true
                    docker compose -f /pocketing/docker-compose.pocketing.yml rm -f ${NEXT_BACKEND} || true
                    docker compose -f /pocketing/docker-compose.pocketing.yml build --no-cache ${NEXT_BACKEND}
                    docker compose -f /pocketing/docker-compose.pocketing.yml up -d ${NEXT_BACKEND}
                    """
                }
            }
        }

//         stage('Health Check') {
//             steps {
//                 script {
//                     def status = sh(
//                         script: "curl -sf http://${NEXT_BACKEND}:8080/actuator/health | grep UP",
//                         returnStatus: true
//                     )
//                     if (status != 0) {
//                         error("🚨 ${NEXT_BACKEND} health check 실패")
//                     } else {
//                         echo "✅ ${NEXT_BACKEND} health check 성공"
//                     }
//                 }
//             }
//         }

        stage('Health Check') {
          steps {
            sh '''
              set -e

              # backend-blue 컨테이너의 네트워크/아이피 구하기
              CID=$(docker compose -f /pocketing/docker-compose.pocketing.yml ps -q backend-blue)
              NET=$(docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{printf "%s\\n" $k}}{{end}}' "$CID" | head -n1)
              IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$CID")
              echo "healthcheck net=$NET ip=$IP"

              # 같은 네트워크에서 호출 (Host 헤더는 유효한 값으로)
              docker run --rm --network "$NET" curlimages/curl:8.7.1 \
                sh -lc 'for i in $(seq 1 40); do
                  CODE=$(curl -s -o /tmp/h -w "%{http_code}" -H "Host: localhost" http://'"$IP"':8080/actuator/health || true)
                  BODY=$(cat /tmp/h || true)
                  echo "try:$i code:$CODE body:$BODY"
                  if [ "$CODE" = "200" ] && echo "$BODY" | grep -q "UP"; then
                    echo "health UP"; exit 0
                  fi
                  sleep 2
                done
                echo "health not UP in time"; exit 1'
            '''
          }
        }

        stage('Switch Nginx Upstream') {
            steps {
                sh """
                echo "🔧 switch_nginx.sh 실행 준비"
                chmod +x ${SWITCH_SCRIPT}
                bash ${SWITCH_SCRIPT}
                """
            }
        }

        stage('Reload Nginx') {
            steps {
                sh """
                echo "🔁 frontend 컨테이너에서 Nginx 설정 재적용"
                docker exec frontend nginx -t
                docker exec frontend nginx -s reload
                echo "✅ Nginx 설정 반영 완료"
                """
            }
        }

        stage('Shutdown Old Backend') {
            steps {
                sh """
                docker compose -f /pocketing/docker-compose.pocketing.yml stop ${CURRENT_BACKEND} || true
                docker compose -f /pocketing/docker-compose.pocketing.yml rm -f ${CURRENT_BACKEND} || true
                echo "🧹 이전 백엔드(${CURRENT_BACKEND}) 종료 완료"
                """
            }
        }
    }
}
